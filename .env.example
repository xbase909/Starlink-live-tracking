# Position de l'antenne (clic droit sur Google Maps). Quelques centaines de mètres de précision suffisent.
DISH_LAT=48.8566
DISH_LON=2.3522
# Altitude en mètres (optionnel, effet négligeable)
DISH_ALT=0
# Adresse gRPC de l'antenne (ne change pas sauf configuration réseau particulière)
DISH_TARGET=192.168.100.1:9200
# Port de la page web
WEB_PORT=8090
